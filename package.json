{
  "name": "fantasyfinance",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate": "cargo run -p gen-bindings -- --out-dir src/module_bindings --module-path spacetimedb && prettier --write src/module_bindings",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:start": "spacetime start",
    "spacetime:publish:local": "spacetime publish fantasyfinance --module-path spacetimedb --server local --yes",
    "spacetime:publish": "spacetime publish fantasyfinance --module-path spacetimedb --server maincloud",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:nessie": "tsx scripts/seed-nessie.ts",
    "smoke": "tsx scripts/smoke-render.tsx",
    "verify:nessie": "tsx scripts/verify-nessie.ts",
    "verify:coach": "tsx scripts/verify-coach.ts",
    "sim:league": "tsx scripts/sim-league.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
