# Copy these into .env.local (gitignored). No VITE_ prefix on purpose:
# the key is read by the Vite dev-server proxy and never reaches the browser.
NESSIE_API_KEY=your-nessie-key-here
# Optional override if your key's welcome email names a different host.
NESSIE_BASE_URL=https://api.nessieisreal.com
