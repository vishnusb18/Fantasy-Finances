# Copy these into .env.local (gitignored). No VITE_ prefix on purpose:
# the key is read by the Vite dev-server proxy and never reaches the browser.
NESSIE_API_KEY=your-nessie-key-here
# Optional override if your key's welcome email names a different host.
NESSIE_BASE_URL=https://api.nessieisreal.com

# SpacetimeDB (player state + live league). These ARE exposed to the browser.
# Default: the shared league on maincloud. For a local server (spacetime start):
# VITE_SPACETIMEDB_HOST=ws://localhost:3000
# VITE_SPACETIMEDB_DB=fantasyfinance
# Set to true to run without SpacetimeDB (browser storage only).
# VITE_SPACETIMEDB_DISABLED=false
